{
  "cli": {
    "version": ">= 16.20.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_VARIANT": "store"
      }
    },
    "dev": {
      "distribution": "internal",
      "channel": "dev",
      "env": {
        "APP_VARIANT": "dev"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "tester": {
      "distribution": "internal",
      "channel": "testers",
      "env": {
        "APP_VARIANT": "test"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
