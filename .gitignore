npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# 2026-08-11: real, confirmed root cause of a genuine on-device hang --
# assets/data/foods_reference.db.bak-* backup copies (this project's own
# established "cp before a risky edit" safety convention) accumulated
# across one long session, 11 of them, ~1.45GB, sitting alongside the
# real ~133MB reference database inside the one directory that gets
# scanned/watched as a bundled app asset directory. Nothing in the app
# actually require()s these -- Metro's default asset bundling only
# includes files a real require() call names -- but Metro's own dev-time
# project crawl/haste-map build still walks the whole watched tree
# regardless, and a bundled ~1.6GB assets/data/ (vs. the real ~133MB it
# should be) is the direct, confirmed explanation for the reference-
# database import repeatedly timing out on a real device. The same
# backup convention is still fine to use -- just never inside assets/,
# where it gets bundled/watched; a scratchpad location doesn't have this
# risk.
assets/data/*.bak*
assets/data/test_alt_shape.db
assets/data/test_current_shape.db

# Scratch/working files -- raw nutrition-database source data (large
# spreadsheets, zips, sqlite dumps) for the separate nutrition-database
# project, plus manual file backups made during risky edits. Not part of
# the app itself; deliberately excluded so the repo stays scoped to actual
# app code, not large unrelated data files.
ClaudeWork/

# unified-database's large cached input artifact: an extracted copy of
# the legacy 7-source raw database (120MB, derived from ClaudeWork's
# already-excluded zipped original).
unified-database/.cache/

# The two SQLite databases left git on 2026-09-21. Each had been a Git
# LFS file, and every commit of one uploaded a whole new 161 MB or 115 MB
# object that GitHub keeps for good: 110 versions in history put the
# account at 90% of its 10 GiB of LFS storage. They live on disk here,
# EAS still uploads them for a build (.easignore does not exclude them),
# and node scripts/backup_reference_dbs.js copies them to OneDrive; run
# it whenever either one changes. Do not add either back to git.
assets/data/foods_reference.db
unified-database/unified_foods.sqlite

# The audit tool's own derived, fully-regeneratable build outputs --
# audit-data.json (a plain SQL export of unified_foods.sqlite) and
# unified-audit-built.html (that export spliced into the real,
# hand-authored unified-audit.html template). Neither carries anything
# the real, committed unified_foods.sqlite and the template itself don't
# already hold -- `node pipeline/export-audit-data.js && node
# pipeline/build-audit-tool.js` regenerates both from scratch in seconds
# whenever the tool needs republishing after a real review/apply pass.
unified-database/audit-tool/audit-data.json
unified-database/audit-tool/unified-audit-built.html

# Real, disposable scratch files this pipeline's own test runs and
# manual database-file swaps create and clean up after themselves --
# excluded defensively in case a run is ever interrupted mid-test.
unified-database/_*.sqlite
unified-database/_*.json

# Claude Code local state -- settings.local.json is personal-machine
# overrides by Claude Code's own convention, not meant to be shared/synced
# between machines; scheduled_tasks.lock is a runtime lock file, not content.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Stray tsc output dumps from earlier ad-hoc debugging
tsc_out*.txt
tsc_check*.txt

# Generated data for the Digest depth-push tracker (see scripts/digest-tracker/README.md)
scripts/digest-tracker/digest-tracker-data.json

# Pre-trim backup of the oversized CLAUDE.md (full history is versioned at docs/CLAUDE-ARCHIVE.md)
CLAUDE.md.bak

# Python bytecode cache from running one-off scripts/*.py content-authoring scripts
scripts/__pycache__/

_recovered/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# Firebase config for the push relay (project inside-story-app). Holds app
# identifiers, so it stays out of git; eas build still uploads it because
# .easignore, not this file, decides what goes to the build server.
google-services.json

# Gradle output from a local compile of a local Expo module
modules/*/android/build/

# The speech engine, fetched by desktop/fetch-whisper.js at build time.
desktop/whisper/
