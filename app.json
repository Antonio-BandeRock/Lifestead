{
  "expo": {
    "name": "Lifestead",
    "slug": "inside-story",
    "owner": "inside-story",
    "version": "1.0.76.4",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "hashimotosapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4df4360a-6556-4989-8ad3-dcae28961d17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.insidestoryapp.app",
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Lifestead Share",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.insidestoryapp.app.is-share"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.insidestoryapp.app.is-share",
            "UTTypeDescription": "Lifestead Share",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "is"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "package": "com.insidestoryapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F2A2C",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.VIBRATE",
        "android.permission.WRITE_CALENDAR",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.WRITE_HYDRATION",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.READ_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "*/*",
              "host": "*",
              "pathPattern": ".*\\.is"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "host": "*",
              "pathPattern": ".*\\.is"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "insidestoryapp.com",
              "pathPrefix": "/connect"
            },
            {
              "scheme": "https",
              "host": "insidestoryapp.com",
              "pathPrefix": "/import-shared"
            },
            {
              "scheme": "https",
              "host": "lifestead.app",
              "pathPrefix": "/connect"
            },
            {
              "scheme": "https",
              "host": "lifestead.app",
              "pathPrefix": "/import-shared"
            },
            {
              "scheme": "https",
              "host": "lifestead.ghostead.com",
              "pathPrefix": "/connect"
            },
            {
              "scheme": "https",
              "host": "lifestead.ghostead.com",
              "pathPrefix": "/import-shared"
            }
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "androidNavigationBar": {
      "enforceContrast": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F2A2C",
          "dark": {
            "backgroundColor": "#1F2A2C"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-asset",
      "expo-localization",
      "expo-font",
      "expo-navigation-bar",
      "./plugins/withWindowBackground.js",
      "./plugins/withAutofillDisabled.js",
      "./plugins/withNoCompressDb.js",
      "./plugins/withCleartextLan.js",
      "./plugins/withCaptureTile.js",
      [
        "expo-calendar",
        {
          "calendarPermission": "Lifestead uses your calendar to show upcoming appointments here and to add appointments you schedule in Lifestead to your calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lifestead uses your photos to let you choose a custom background image, or a photo of a meal you've made.",
          "cameraPermission": "Lifestead uses your camera to let you take a photo of a meal you've made, or of an ingredient label or price tag while scanning a product."
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lifestead uses your microphone to let you search and add notes by speaking instead of typing.",
          "speechRecognitionPermission": "Lifestead uses speech recognition to turn what you say into text for search boxes and notes."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lifestead uses your camera to scan a product's barcode while you're shopping."
        }
      ],
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": [
            "latin"
          ],
          "ocrUseBundled": true
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#1F2A2C",
          "sounds": [
            "./assets/sounds/ls_bell.wav",
            "./assets/sounds/ls_chime.wav",
            "./assets/sounds/ls_falling.wav",
            "./assets/sounds/ls_glass.wav",
            "./assets/sounds/ls_knock.wav",
            "./assets/sounds/ls_marimba.wav",
            "./assets/sounds/ls_ping.wav",
            "./assets/sounds/ls_pulse.wav",
            "./assets/sounds/ls_rising.wav",
            "./assets/sounds/ls_sonar.wav",
            "./assets/sounds/ls_sweep.wav",
            "./assets/sounds/ls_triple_beep.wav",
            "./assets/sounds/ls_two_down.wav",
            "./assets/sounds/ls_two_up.wav",
            "./assets/sounds/ls_urgent.wav",
            "./assets/sounds/ls_warble.wav"
          ]
        }
      ],
      "expo-quick-actions",
      "expo-audio",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lifestead uses Face ID to unlock the app when you have turned App Lock on."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Lifestead saves the full-size photos you take in the app to your gallery, when you have asked it to.",
          "savePhotosPermission": "Lifestead saves the full-size photos you take in the app to your gallery, when you have asked it to.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lifestead uses your approximate location, only when you ask, to fetch the weather for your area. It is rounded before anything is sent.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Lifestead lets you pick a person from your contacts for an emergency contact, a prescriber, a pharmacy or a family member. Nothing is copied out of your phone."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextThing",
              "label": "Next thing",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "What comes next in your day",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextDose",
              "label": "Next dose",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "Your next medicine or supplement",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Capture",
              "label": "Capture",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "Jot something down",
              "resizeMode": "horizontal"
            },
            {
              "name": "Grocery",
              "label": "Grocery list",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "description": "What is still on the list",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FuelGauges",
              "label": "Fuel gauges",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Where today stands on your key nutrients",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "RoutineStep",
              "label": "Routine step",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "The step you are on in a routine",
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "Glass",
              "label": "A glass of water",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "Record a glass with one tap",
              "resizeMode": "horizontal"
            }
          ]
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4df4360a-6556-4989-8ad3-dcae28961d17"
      }
    }
  }
}
