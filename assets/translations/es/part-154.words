 "Colour Blindness": "Daltonismo",
 "Nothing recorded to chart.": "No hay nada registrado para la gráfica.",
 "Chart of one point: {value} on {date}.": "Gráfica de un solo punto: {value} el {date}.",
 "Line chart of {count} weekly averages.": "Gráfica de líneas con {count} promedios semanales.",
 "Line chart of {count} monthly averages.": "Gráfica de líneas con {count} promedios mensuales.",
 "Line chart of {count} points.": "Gráfica de líneas con {count} puntos.",
